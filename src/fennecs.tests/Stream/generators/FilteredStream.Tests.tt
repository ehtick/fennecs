    [Fact]
    public void TwoDelegatesCoverPrunedArchetypes()
    {
        using var world = new World();

        // three archetypes: bare, +string (half passing the predicate), +string+long
        for (var i = 0; i < 3; i++) world.Spawn()<#= AddChain(T, n, k => "10") #>;
        for (var i = 0; i < 4; i++) world.Spawn()<#= AddChain(T, n, k => "i % 2 == 0 ? 90 : 10") #>.Add("tag");
        for (var i = 0; i < 5; i++) world.Spawn()<#= AddChain(T, n, k => "10") #>.Add("tag").Add(42L);

        var all = world.Stream<<#= types #>>();
        Assert.Equal(12, all.Count);

        var filtered = all
            .Has(Comp<string>.Plain)
            .Not(Comp<long>.Plain)
            .Where((in <#= T0 #> c) => c.Value > 50);
        Assert.Equal(2, filtered.Count);

        // all four For variants: excluded must see the pruned archetypes AND the failing entities
        var included = 0;
        var excluded = 0;
        filtered.For(
            (<#= RefArgs(n, 0) #>) => { included++; Assert.True(c0.Value > 50); },
            (<#= RefArgs(n) #>) => { excluded++; });
        Assert.Equal(2, included);
        Assert.Equal(10, excluded);

        included = 0;
        excluded = 0;
        filtered.For(
            (in e, <#= RefArgs(n, 0) #>) => { Assert.True(e.Alive); included++; },
            (in e, <#= RefArgs(n) #>) => { Assert.True(e.Alive); excluded++; });
        Assert.Equal(2, included);
        Assert.Equal(10, excluded);

        included = 0;
        excluded = 0;
        filtered.For(4711,
            (uniform, <#= RefArgs(n, 0) #>) => { Assert.Equal(4711, uniform); included++; },
            (uniform, <#= RefArgs(n) #>) => { Assert.Equal(4711, uniform); excluded++; });
        Assert.Equal(2, included);
        Assert.Equal(10, excluded);

        included = 0;
        excluded = 0;
        filtered.For(4711,
            (uniform, in e, <#= RefArgs(n, 0) #>) => { Assert.Equal(4711, uniform); Assert.True(e.Alive); included++; },
            (uniform, in e, <#= RefArgs(n) #>) => { Assert.Equal(4711, uniform); Assert.True(e.Alive); excluded++; });
        Assert.Equal(2, included);
        Assert.Equal(10, excluded);

        // both two-delegate Jobs: pruned archetypes are dispatched as unconditional work items
        included = 0;
        excluded = 0;
        filtered.Job(
            (<#= RefArgs(n, 0) #>) => { Interlocked.Increment(ref included); Assert.True(c0.Value > 50); },
            (<#= RefArgs(n) #>) => { Interlocked.Increment(ref excluded); });
        Assert.Equal(2, included);
        Assert.Equal(10, excluded);

        included = 0;
        excluded = 0;
        filtered.Job(4711,
            (uniform, <#= RefArgs(n, 0) #>) => { Assert.Equal(4711, uniform); Interlocked.Increment(ref included); },
            (uniform, <#= RefArgs(n) #>) => { Assert.Equal(4711, uniform); Interlocked.Increment(ref excluded); });
        Assert.Equal(2, included);
        Assert.Equal(10, excluded);
    }

    [Fact]
    public void HasUsesAndSemantics()
    {
        using var world = new World();

        // four archetypes; only one has BOTH the string and the long component
        world.Spawn()<#= AddChain(T, n, k => "1") #>;
        world.Spawn()<#= AddChain(T, n, k => "2") #>.Add("s");
        world.Spawn()<#= AddChain(T, n, k => "3") #>.Add(42L);
        world.Spawn()<#= AddChain(T, n, k => "4") #>.Add("s").Add(42L);

        var all = world.Stream<<#= types #>>();
        var both = all.Has(Comp<string>.Plain, Comp<long>.Plain);

        // AND semantics: only the archetype with both components matches (OR would match 3)
        Assert.Equal(1, both.Count);

        var visited = 0;
        both.For((<#= RefArgs(n, 0) #>) =>
        {
            visited++;
            Assert.Equal(4, c0.Value);
        });
        Assert.Equal(1, visited);

        visited = 0;
        both.For((in e, <#= RefArgs(n, 0) #>) =>
        {
            Assert.True(e.Alive);
            visited++;
            Assert.Equal(4, c0.Value);
        });
        Assert.Equal(1, visited);

        visited = 0;
        both.For(4711, (uniform, <#= RefArgs(n, 0) #>) =>
        {
            Assert.Equal(4711, uniform);
            visited++;
            Assert.Equal(4, c0.Value);
        });
        Assert.Equal(1, visited);

        visited = 0;
        both.For(4711, (uniform, in e, <#= RefArgs(n, 0) #>) =>
        {
            Assert.Equal(4711, uniform);
            Assert.True(e.Alive);
            visited++;
            Assert.Equal(4, c0.Value);
        });
        Assert.Equal(1, visited);

        var enumerated = 0;
        foreach (var row in both)
        {
            enumerated++;
            Assert.Equal(4, row.Item2.Value);
        }
        Assert.Equal(1, enumerated);
    }

    [Fact]
    public void FiltersAccumulateAndPredicatesReplace()
    {
        using var world = new World();

        world.Spawn()<#= AddChain(T, n, k => "1") #>;
        world.Spawn()<#= AddChain(T, n, k => "2") #>.Add("s");
        world.Spawn()<#= AddChain(T, n, k => "3") #>.Add(42L);
        world.Spawn()<#= AddChain(T, n, k => "4") #>.Add("s").Add(42L);

        var all = world.Stream<<#= types #>>();

        // chained Has accumulates like a single multi-expression Has
        Assert.Equal(1, all.Has(Comp<string>.Plain).Has(Comp<long>.Plain).Count);
        Assert.Equal(all.Has(Comp<string>.Plain, Comp<long>.Plain).Count,
            all.Has(Comp<string>.Plain).Has(Comp<long>.Plain).Count);

        // chained Not accumulates like a single multi-expression Not
        Assert.Equal(1, all.Not(Comp<string>.Plain).Not(Comp<long>.Plain).Count);
        Assert.Equal(all.Not(Comp<string>.Plain, Comp<long>.Plain).Count,
            all.Not(Comp<string>.Plain).Not(Comp<long>.Plain).Count);

        // a second Where on the same component replaces the first predicate
        var replaced = all
            .Where((in <#= T0 #> c) => c.Value > 1000)
            .Where((in <#= T0 #> c) => c.Value >= 0);
        Assert.Equal(all.Count, replaced.Count);

        // Where predicates chained across components conjoin
        var conjunction = all<# for (var j = 0; j < n; j++) { #>
            .Where((in <#= T[j] #> c) => c.Value >= 2)<# } #>;
        Assert.Equal(3, conjunction.Count);
        Assert.NotEmpty(conjunction.ToString());
    }

    [Theory]
    [ClassData(typeof(StreamCountGenerator))]
    public void CountAndEnumerationHonorPredicates(int count, bool createEmptyTable)
    {
        using var world = new World();

        //Create an empty table by spawning and despawning a single entity
        //that matches our test Query (but is a larger Archetype)
        if (createEmptyTable)
        {
            var dead = world.Spawn()<#= AddChain(T, n, k => "0") #>.Add(0.25f);
            world.Despawn(dead);
        }

        var expected = 0;
        for (var index = 0; index < count; index++)
        {
            world.Spawn()<#= AddChain(T, n, k => "index % 100") #>;
            if (index % 100 > 50) expected++;
        }

        var filtered = world.Stream<<#= types #>>().Where((in <#= T0 #> c) => c.Value > 50);
        Assert.Equal(expected, filtered.Count);

        var seen = 0;
        foreach (var row in filtered)
        {
            seen++;
            Assert.True(row.Item2.Value > 50);
        }
        Assert.Equal(expected, seen);

        IEnumerable boxed = filtered;
        var boxedSeen = 0;
        foreach (var unused in boxed) boxedSeen++;
        Assert.Equal(expected, boxedSeen);
    }

    [Fact]
    public void CannotStructuralChangeWhileEnumerating()
    {
        using var world = new World();
        world.Spawn()<#= AddChain(T, n, k => "60") #>;
        world.Spawn()<#= AddChain(T, n, k => "70") #>;

        var filtered = world.Stream<<#= types #>>().Where((in <#= T0 #> c) => c.Value > 50);
        Assert.Throws<InvalidOperationException>(() =>
        {
            foreach (var row in filtered)
            {
                row.Item1.Remove<<#= T0 #>>();
            }
        });
    }

    [Fact]
    public void DespawnHonorsArchetypeFilters()
    {
        using var world = new World();

        world.Spawn()<#= AddChain(T, n, k => "10") #>;
        world.Spawn()<#= AddChain(T, n, k => "20") #>.Add("doomed");
        world.Spawn()<#= AddChain(T, n, k => "30") #>.Add("doomed");

        var all = world.Stream<<#= types #>>();
        Assert.Equal(3, all.Count);

        all.Has(Comp<string>.Plain).Despawn();

        Assert.Equal(1, all.Count);
        all.For((<#= RefArgs(n, 0) #>) => Assert.Equal(10, c0.Value));
    }

    [Fact]
    public void DespawnHonorsPredicates()
    {
        using var world = new World();

        // an empty archetype exercises the empty-join skip during collection
        var dead = world.Spawn()<#= AddChain(T, n, k => "0") #>.Add(0.25f);
        world.Despawn(dead);

        world.Spawn()<#= AddChain(T, n, k => "10") #>;
        world.Spawn()<#= AddChain(T, n, k => "90") #>;
        world.Spawn()<#= AddChain(T, n, k => "95") #>.Add("extended");
        world.Spawn()<#= AddChain(T, n, k => "99") #>.Add(42L); // sheltered by the Not clause
        var outsider = world.Spawn().Add("outsider");

        var filtered = world.Stream<<#= types #>>()
            .Not(Comp<long>.Plain)
            .Where((in <#= T0 #> c) => c.Value > 50);
        Assert.Equal(2, filtered.Count);

        filtered.Despawn();

        Assert.Equal(0, filtered.Count);
        Assert.Equal(2, world.Stream<<#= types #>>().Count);
        Assert.True(outsider.Alive);
        world.Stream<<#= types #>>().For((<#= RefArgs(n, 0) #>) => Assert.True(c0.Value is 10 or 99));
    }

    [Fact]
    public void EmptyFiltersBehaveLikeStream()
    {
        using var world = new World();

        world.Spawn()<#= AddChain(T, n, k => "1") #>;
        world.Spawn()<#= AddChain(T, n, k => "2") #>.Add("extended");

        var all = world.Stream<<#= types #>>();
        var unfiltered = all.Has();

        Assert.Equal(all.Count, unfiltered.Count);

        var included = 0;
        var excluded = 0;
        unfiltered.For(
            (<#= RefArgs(n) #>) => { included++; },
            (<#= RefArgs(n) #>) => { excluded++; });
        Assert.Equal(all.Count, included);
        Assert.Equal(0, excluded);

        Assert.NotEmpty(unfiltered.ToString());
    }

    [Fact]
    public void UnderlyingStreamDropsDown()
    {
        using var world = new World();

        world.Spawn()<#= AddChain(T, n, k => "10") #>;
        world.Spawn()<#= AddChain(T, n, k => "90") #>;

        var all = world.Stream<<#= types #>>();
        var filtered = all.Where((in <#= T0 #> c) => c.Value > 50);

        Assert.Equal(1, filtered.Count);
        Assert.True(filtered.Stream == all);
        Assert.Equal(2, filtered.Stream.Count);

        var visited = 0;
        filtered.Stream.For((<#= RefArgs(n) #>) => { visited++; });
        Assert.Equal(2, visited);
    }

    [Fact]
    public void JobWithArchetypeFiltersOnly()
    {
        using var world = new World();

        for (var i = 0; i < 100; i++) world.Spawn()<#= AddChain(T, n, k => "7") #>.Add("tag");
        for (var i = 0; i < 50; i++) world.Spawn()<#= AddChain(T, n, k => "8") #>;

        var filtered = world.Stream<<#= types #>>().Has(Comp<string>.Plain);

        var visited = 0;
        filtered.Job((<#= RefArgs(n, 0) #>) =>
        {
            Interlocked.Increment(ref visited);
            Assert.Equal(7, c0.Value);
        });
        Assert.Equal(100, visited);

        visited = 0;
        filtered.Job(4711, (uniform, <#= RefArgs(n, 0) #>) =>
        {
            Assert.Equal(4711, uniform);
            Interlocked.Increment(ref visited);
            Assert.Equal(7, c0.Value);
        });
        Assert.Equal(100, visited);
    }

    [Fact]
    public void WildcardOperationsThrow()
    {
        using var world = new World();
        world.Spawn()<#= AddChain(T, n, k => "1") #>;

        var filtered = world.Query<<#= types #>>(Match.Any).Stream().Where((in <#= T0 #> c) => c.Value > 0);

        Assert.Throws<InvalidOperationException>(() => filtered.Job((<#= RefArgs(n) #>) => { }));
        Assert.Throws<InvalidOperationException>(() => filtered.Job(1, (uniform, <#= RefArgs(n) #>) => { }));

        Assert.Throws<InvalidOperationException>(() => filtered.For(
            (<#= RefArgs(n) #>) => { },
            (<#= RefArgs(n) #>) => { }));
        Assert.Throws<InvalidOperationException>(() => filtered.For(
            (in e, <#= RefArgs(n) #>) => { },
            (in e, <#= RefArgs(n) #>) => { }));
        Assert.Throws<InvalidOperationException>(() => filtered.For(1,
            (uniform, <#= RefArgs(n) #>) => { },
            (uniform, <#= RefArgs(n) #>) => { }));
        Assert.Throws<InvalidOperationException>(() => filtered.For(1,
            (uniform, in e, <#= RefArgs(n) #>) => { },
            (uniform, in e, <#= RefArgs(n) #>) => { }));

        Assert.Throws<InvalidOperationException>(() => filtered.Job(
            (<#= RefArgs(n) #>) => { },
            (<#= RefArgs(n) #>) => { }));
        Assert.Throws<InvalidOperationException>(() => filtered.Job(1,
            (uniform, <#= RefArgs(n) #>) => { },
            (uniform, <#= RefArgs(n) #>) => { }));

        Assert.Throws<InvalidOperationException>(() => filtered.Despawn());
    }
}
<#
    } // end for set / arity
#>
